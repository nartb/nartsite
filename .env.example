# Copy to .env before deploying (or set these on the stack in Komodo).
# .env is gitignored

# Name of the Docker volume holding the Obsidian vault. This is created and
# written by the obsidian-headless-sync stack; this stack mounts it read-only.
# Compose will refuse to start if it does not already exist.
VAULT_VOLUME=obsidian-vault

# Name of the volume the site is served from
SERVE_VOLUME=serve

# Path to the content directory the vault's content will be mounted to
QUARTZ_CONTENT_DIR=/content

# Path for Quartz to build the site to
QUARTZ_BUILD_DIR=/build

# Path for built sites to be copied to for Caddy to serve
QUARTZ_SERVE_DIR=/serve

# Host port Caddy publishes on — this is what the Cloudflare tunnel points at.
# Not needed if you put cloudflared on a shared Docker network instead (see the
# commented networks block in compose.yaml).
EXTERNAL_SITE_PORT=8080

# Internal port Caddy publishes to
INTERNAL_SITE_PORT=80

# Quartz image name and tag to publish
QUARTZ_IMAGE=nartsite-quartz:latest

# Interval between attempts to publish a newly built site
PUBLISH_INTERVAL_SECONDS=2

# Duration to wait for there to be no changes to the built site files before assuming it's ready to publish
SETTLED_BUILD_SECONDS=3
